{
  "name": "egitim-ci-demo",
  "version": "1.0.0",
  "description": "GitHub Actions CI/CD Egitim Projesi",
  "main": "src/index.js",
  "scripts": {
    "start":    "node src/index.js",
    "dev":      "nodemon src/index.js",
    "test":     "jest --coverage --forceExit",
    "lint":     "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors":    "^2.8.5"
  },
  "devDependencies": {
    "jest":       "^29.7.0",
    "supertest":  "^6.3.4",
    "eslint":     "^8.57.0",
    "nodemon":    "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageThreshold": {
      "global": { "lines": 70 }
    }
  }
}
